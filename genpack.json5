{
    profile: "paravirt",
    packages: [
        "media-libs/fontconfig",
        "app-crypt/mit-krb5",
        "media-fonts/noto-cjk",
        "media-fonts/noto-emoji",
        "net-firewall/nftables",
        "net-vpn/frp",
    ],
    buildtime_packages: [
        "app-arch/dpkg",
        "dev-util/patchelf",
    ],
    users: [
        { name: "cool", home: "/opt/cool" },
    ],
    services: ["coolwsd", "nftables", "vsock-export-coolwsd"],
}
// vm run -m 8192 --sock-proxy=80 -d code.img code-x86_64.squashfs
